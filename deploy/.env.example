# Copy to deploy/.env and fill in. docker compose reads it automatically.

# Fernet key that encrypts secrets at rest. Generate one with:
#   cd backend && uv run exradius generate-key
EXRADIUS_SECRET_KEY=
# First admin login. The password only seeds the admin user when none exists; change it
# later in the admin panel (Settings), not here.
EXRADIUS_ADMIN_USERNAME=admin
EXRADIUS_ADMIN_PASSWORD=

# Host directory for run directories, git mirrors and (by default) the object store
# with transcripts, artifacts and attachments. It must be an absolute path that the
# Docker daemon can bind-mount (on macOS, somewhere under /Users).
EXRADIUS_DATA_DIR=/var/lib/exradius

# Base URL at which consumers of exradius.events reach the API. task.result carries
# artifact and transcript download URLs built from it.
EXRADIUS_PUBLIC_API_URL=http://localhost:8000

# Object store: "filesystem" (default, under $EXRADIUS_DATA_DIR/objects) or "s3" for
# any S3 API. For S3, uncomment and fill in (leave the endpoint empty for AWS S3):
# EXRADIUS_OBJECT_STORE=s3
# EXRADIUS_S3_ENDPOINT_URL=https://s3.example.com
# EXRADIUS_S3_ACCESS_KEY=
# EXRADIUS_S3_SECRET_KEY=
# EXRADIUS_S3_BUCKET=exradius
# EXRADIUS_S3_REGION=us-east-1

# Images the worker uses (compose builds both; override to use your own tags):
# the Claude Code runtime bundle, mounted into every run container, and the image of run
# containers for projects that name no image.
# EXRADIUS_RUNTIME_IMAGE_CLAUDE_CODE=exradius-runtime-claude-code:0.1.0
# EXRADIUS_PROJECT_DEFAULT_IMAGE=exradius-project-default:0.1.0

# How many runs one worker executes at once (the task consumer's prefetch count).
EXRADIUS_WORKER_CONCURRENCY=4

# Infrastructure credentials (defaults shown).
# POSTGRES_PASSWORD=exradius
# RABBITMQ_USER=exradius
# RABBITMQ_PASSWORD=exradius

# Host ports (change them if they are taken).
# EXRADIUS_API_PORT=8000
# EXRADIUS_AMQP_PORT=5672
# EXRADIUS_RABBITMQ_UI_PORT=15672
# EXRADIUS_POSTGRES_PORT=5432
